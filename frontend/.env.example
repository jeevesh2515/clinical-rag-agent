# Frontend environment variables

# Vite exposes only variables prefixed with VITE_ to the client bundle.
# WARNING: Do NOT set VITE_API_URL to a localhost/dev URL in production builds.
# The frontend must use relative paths (empty string) so Vercel routes /api/*
# to the Python serverless functions on the same domain.
#
# Local development uses Vite's proxy (vite.config.ts), so leaving this empty
# here works for both local dev and production.
VITE_API_URL=

# Optional: Neon Auth base URL if/when Neon Auth is enabled.
# Leave empty to use the default /api/auth paths.
VITE_NEON_AUTH_URL=
