# Kubernetes Secret Template
#
# ⚠️ DO NOT `kubectl apply -f k8s/secret.yaml` after a `cp secret.yaml.template
# secret.yaml` IF you have NOT edited the placeholder values. The placeholder
# `JWT_SECRET_KEY` below is publicly known and would be a critical security
# vulnerability if deployed.
#
# Safe install workflow (recommended):
#
#   1. Generate a strong JWT key:
#        openssl rand -hex 32
#
#   2. Create the secret imperatively with kubectl so it never lives on disk:
#        kubectl create secret generic clinical-app-secrets \
#          --from-literal=JWT_SECRET_KEY="$(openssl rand -hex 32)" \
#          --from-literal=OPENROUTER_API_KEY="sk-or-v1-..." \
#          --from-literal=COHERE_API_KEY="..." \
#          --from-literal=DATABASE_URL="postgresql://..."
#
#   3. (Optional) Sealed Secrets / External Secrets Operator for GitOps.
#
# If you must commit a secret.yaml, run `scripts/verify_everything.py` to
# detect the placeholder keys. The CI workflow also fails on placeholder keys.
apiVersion: v1
kind: Secret
metadata:
  name: clinical-app-secrets
  namespace: default
  labels:
    app.kubernetes.io/name: clinical-workflow-rag
type: Opaque
stringData:
  # REPLACE before applying. CI guard: scripts/verify_everything.py
  JWT_SECRET_KEY: "REPLACE_ME_WITH_OPENSSL_RAND_HEX_32"
  OPENROUTER_API_KEY: "REPLACE_ME_WITH_OPENROUTER_KEY"
  COHERE_API_KEY: "REPLACE_ME_WITH_COHERE_KEY"
  DATABASE_URL: "postgresql://REPLACE_ME_WITH_NEON_OR_POSTGRES_URL?sslmode=require"
