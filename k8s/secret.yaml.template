# Kubernetes Secret Template
# Copy to secret.yaml and populate base64-encoded values before applying to cluster:
# kubectl create secret generic clinical-app-secrets --from-literal=JWT_SECRET_KEY='your-secret' --from-literal=OPENROUTER_API_KEY='your-key' ...
apiVersion: v1
kind: Secret
metadata:
  name: clinical-app-secrets
  namespace: default
  labels:
    app.kubernetes.io/name: clinical-workflow-rag
type: Opaque
stringData:
  JWT_SECRET_KEY: "change-me-in-production-use-a-strong-random-key-32bytes"
  OPENROUTER_API_KEY: "sk-or-v1-your-openrouter-key-here"
  COHERE_API_KEY: "your-cohere-api-key-here"
  DATABASE_URL: "postgresql://user:password@neon-postgresql-host:5432/neondb?sslmode=require"
